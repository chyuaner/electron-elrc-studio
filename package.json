{
  "name": "electron-elrc-maker",
  "version": "1.0.0",
  "description": "Enhanced LRC Maker — Electron 桌面版",
  "homepage": "https://github.com/chyuaner/aistudio-elrc-maker",
  "license": "CC-BY-NC-SA-4.0",
  "author": {
    "name": "Yuan Chiu",
    "email": "chyuaner@gmail.com"
  },
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "postinstall": "cd aistudio-elrc-maker && npm install",
    "build:icons": "node scripts/generate-icons.js",
    "build:web": "cd aistudio-elrc-maker && npm run build",
    "start": "cross-env ELECTRON_RUN_AS_NODE= electron .",
    "watch:web": "chokidar \"aistudio-elrc-maker/{app,components,lib,hooks}/**/*.{ts,tsx,css}\" --ignore \"**/node_modules/**\" -c \"npm run build:web\"",
    "dev": "npm run build:icons && npm run build:web && concurrently -k -n watch,app \"npm run watch:web\" \"cross-env ELECTRON_RUN_AS_NODE= electronmon .\"",
    "dev:web": "cd aistudio-elrc-maker && npm run dev",
    "pack": "npm run build:icons && npm run build:web && cross-env ELECTRON_RUN_AS_NODE= electron-builder --dir",
    "dist": "npm run build:icons && npm run build:web && cross-env ELECTRON_RUN_AS_NODE= electron-builder"
  },
  "electronmon": {
    "patterns": [
      "!aistudio-elrc-maker/{app,components,lib,hooks}/**",
      "!aistudio-elrc-maker/.next/**",
      "aistudio-elrc-maker/dist/**"
    ]
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.3",
    "png2icons": "^2.0.1"
  },
  "build": {
    "appId": "tw.yuaner.elrc-maker",
    "productName": "LRC Maker Enhanced",
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": "lrc",
        "name": "Lyric File",
        "description": "LRC 動態歌詞檔",
        "role": "Editor",
        "mimeType": "text/x-lrc"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "static-server.js",
      "electron-window.js",
      "electron-shell-config.js",
      "electron-app-config.js",
      "electron-shell.css",
      "electron-bootstrap.js",
      "package.json",
      "aistudio-elrc-maker/dist/**/*",
      "build/icon.png"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "AudioVideo",
      "mimeTypes": [
        "text/x-lrc"
      ],
      "maintainer": "Yuan Chiu <chyuaner@gmail.com>",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.icns"
    }
  }
}
