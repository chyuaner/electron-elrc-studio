{
  "name": "electron-elrc-studio",
  "description": "Enhanced LRC Studio — Electron 桌面版",
  "homepage": "https://github.com/chyuaner/web-elrc-studio",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Yuan Chiu",
    "email": "chyuaner@gmail.com"
  },
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "postinstall": "cd web-elrc-studio && npm install",
    "build:icons": "node scripts/generate-icons.js",
    "build:web": "cd web-elrc-studio && npm run build",
    "start": "electron .",
    "watch:web": "chokidar \"web-elrc-studio/{app,components,lib,hooks}/**/*.{ts,tsx,css}\" --ignore \"**/node_modules/**\" -c \"npm run build:web\"",
    "dev": "npm run build:icons && npm run build:web && concurrently -k -n watch,app \"npm run watch:web\" \"electronmon .\"",
    "dev:web": "cd web-elrc-studio && npm run dev",
    "pack": "npm run build:icons && npm run build:web && node scripts/build.js --dir",
    "dist": "npm run build:icons && npm run build:web && node scripts/build.js",
    "build": "npm run dist"
  },
  "electronmon": {
    "patterns": [
      "!web-elrc-studio/{app,components,lib,hooks}/**",
      "!web-elrc-studio/.next/**",
      "web-elrc-studio/dist/**"
    ]
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.3",
    "png2icons": "^2.0.1"
  },
  "build": {
    "appId": "tw.yuaner.elrc-maker",
    "productName": "Enhanced LRC Studio",
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": "lrc",
        "name": "Lyric File",
        "description": "LRC 動態歌詞檔",
        "role": "Editor",
        "mimeType": "text/x-lrc"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "static-server.js",
      "electron-window.js",
      "electron-shell-config.js",
      "electron-app-config.js",
      "electron-shell.css",
      "electron-bootstrap.js",
      "package.json",
      "web-elrc-studio/dist/**/*",
      "build/icon.png"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "AudioVideo",
      "mimeTypes": [
        "text/x-lrc"
      ],
      "maintainer": "Yuan Chiu <chyuaner@gmail.com>",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.icns"
    }
  }
}
